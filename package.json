{
  "name": "mobileboost-actions",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Actions for the MobileBoost mobile test automation platform.",
  "repository": {
    "type": "git",
    "url": "https://github.com/MobileBoostHQ/actions.git"
  },
  "license": "MIT",
  "author": "MobileBoost",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:upload": "ncc build src/upload-build/main.ts -o upload-build/dist --source-map --license licenses.txt",
    "build:run": "ncc build src/run-tests/main.ts -o run-tests/dist --source-map --license licenses.txt",
    "build": "npm run build:upload && npm run build:run && npm run build:tunnel && npm run build:tunnel-post",
    "lint": "eslint src tests --ext .ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "e2e:local": "node scripts/local-e2e.mjs",
    "mock-upload": "node scripts/mock-upload-server.mjs",
    "all": "npm run lint && npm run test && npm run build",
    "build:tunnel": "ncc build src/setup-local-tunnel/main.ts -o setup-local-tunnel/dist --source-map --license licenses.txt",
    "build:tunnel-post": "ncc build src/setup-local-tunnel/post.ts -o setup-local-tunnel/dist-post --source-map --license licenses.txt && node scripts/merge-post-bundle.mjs"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/glob": "^0.5.0",
    "@actions/http-client": "^2.2.3",
    "archiver": "^7.0.1",
    "form-data": "^4.0.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "nock": "^13.5.5",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  }
}
