# Copy to .env.local and fill in real values, then:
#   npm run e2e:local

# --- Required ---------------------------------------------------------------
MOBILEBOOST_API_KEY=mb_live_xxxxxxxxxxxxxxxxxxxxxxxx
MOBILEBOOST_ORG_ID=your_org_id

# --- Upload (required unless MODE=run) --------------------------------------
BUILD_PATH=\path\to\app.apk
PLATFORM=android            # ios | android (optional; inferred if omitted)
# METADATA={"branch":"main"}  # optional, must be a JSON object string

# --- Run selection (at least one required unless MODE=upload) ---------------
# TAGS=smoke                  # comma-separated
TEST_IDS=t_abc,t_def
# TAGS_QUERY=

# --- Run behavior (optional) ------------------------------------------------
# ITERATIONS=1
# ASYNC=false
# TIMEOUT_MINUTES=60
# FAIL_ON_TEST_FAILURE=true

# --- Misc -------------------------------------------------------------------
API_URL=https://api.mobileboost.io
# MODE=both                  # both | upload | run
# BUILD_ID=                  # required when MODE=run (skips upload)
